{
  "name": "veloce-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Veloce Lab desktop application",
  "homepage": "https://veloce.flweb.cn",
  "author": {
    "name": "WindyPear Team",
    "email": "fireguo@flweb.cn"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "install:mirror": "node scripts/install-with-mirror.mjs",
    "install:electron": "node scripts/install-electron-with-mirror.mjs",
    "build:electron": "tsc -p tsconfig.json",
    "build:shell": "node scripts/copy-static.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:electron && npm run build:shell && npm run build:server",
    "dist": "npm run build && npm run build:runtimes && electron-builder",
    "start": "npm run build:electron && npm run build:shell && electron ."
  },
  "build": {
    "appId": "com.windypear.veloce.lab",
    "productName": "Veloce Lab",
    "artifactName": "Veloce-Lab-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/logo.png",
      "maintainer": "WindyPear Team <fireguo@flweb.cn>"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2"
  },
  "allowScripts": {}
}
