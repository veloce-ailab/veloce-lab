{
  "core": {
    "host": "0.0.0.0",
    "port": 3000,
    "enableCors": true
  },
  "plugins": {
    "@velocelab/core": {},
    "@velocelab/cache": {
      "enabled": false,
      "address": "127.0.0.1:6379",
      "username": "",
      "password": "",
      "database": "0",
      "tls": false
    },
    "@velocelab/sqlite": { "path": "./data/veloce.db" },
    "@velocelab/model": {},
    "@velocelab/adapters": {},
    "@velocelab/channel": {
      "enabled": true,
      "contextMessageCount": "12",
      "webhookPayloadMaxBytes": "1048576"
    },
    "@velocelab/ratelimit": {
      "enabled": true,
      "requestsPerMinute": "60",
      "burst": "10"
    },
    "@velocelab/service": {
      "environment": "development",
      "dataPath": "./data",
      "jwtSecret": "",
      "nodeName": "",
      "oidcIssuer": "",
      "oidcClientId": "",
      "oidcClientSecret": "",
      "oidcRedirectUrl": "",
      "bootstrapAdminEmails": "",
      "bootstrapAdminOidcSubs": "",
      "authAgreementMode": "notice",
      "passwordRegistrationEnabled": false,
      "passwordHCaptchaEnabled": false
    },
    "@velocelab/middleware": {},
    "@velocelab/api": {
      "siteName": "Veloce",
      "baseUrl": "",
      "edition": "community",
      "communityEnabled": true,
    },
    "@velocelab/file": { "root": "./data" },
    "@velocelab/http": {}
  }
}
