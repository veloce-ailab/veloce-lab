{
  "core": {
    "host": "0.0.0.0",
    "port": 3000,
    "enableCors": true
  },
  "plugins": {
    "@velocelab/cache": {
      "address": "127.0.0.1:6379",
      "username": "",
      "password": "",
      "database": "0",
      "tls": false
    },
    "@velocelab/sqlite": { "path": "./data/veloce.db" },
    "@velocelab/dashboard": {},
    "@velocelab/community": {},
    "@velocelab/knowledge": {},
    "@velocelab/memory": { "root": "./data/memories" },
    "@velocelab/desktop": {},
    "@velocelab/billing": {},
    "@velocelab/scheduler": {},
    "@velocelab/audit": {},
    "@velocelab/user": {},
    "@velocelab/auth": {},
    "@velocelab/model-catalog": {},
    "@velocelab/channel-admin": {},
    "@velocelab/adapters": {},
    "@velocelab/channel": {
      "contextMessageCount": "12",
      "webhookPayloadMaxBytes": "1048576"
    },
    "@velocelab/ratelimit": {
      "requestsPerMinute": "60",
      "burst": "10"
    },
    "@velocelab/service": {
      "environment": "development",
      "dataPath": "./data",
      "jwtSecret": "",
      "nodeName": "",
      "oidcIssuer": "",
      "oidcClientId": "",
      "oidcClientSecret": "",
      "oidcRedirectUrl": "",
      "bootstrapAdminEmails": "",
      "bootstrapAdminOidcSubs": "",
      "authAgreementMode": "notice",
      "passwordRegistrationEnabled": false,
      "passwordHCaptchaEnabled": false
    },
    "@velocelab/advanced-chat": {
      "connectorOnlineWindowSeconds": "60"
    },
    "@velocelab/workspace": {},
    "@velocelab/file": { "root": "./data" }
  }
}
