{
    "name": "@velocelab/dashboard",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./frontend": {
            "types": "./frontend/client.ts",
            "default": "./dist/web/dashboard-client.js"
        },
        "./frontend/extension": {
            "types": "./frontend/client.ts",
            "default": "./dist/web/dashboard-client.js"
        },
        "./frontend/runtime": {
            "types": "./frontend/client.ts",
            "default": "./dist/web/dashboard-client.js"
        },
        "./frontend/client": {
            "types": "./frontend/client.ts",
            "default": "./dist/web/dashboard-client.js"
        }
    },
    "scripts": {
        "build": "../../node_modules/.bin/tsc -p tsconfig.json && ../../node_modules/.bin/vite build && ../../node_modules/.bin/vite build --config vite.client.config.ts"
    },
    "peerDependencies": {
        "yumeri": "^3.0.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.0.1",
        "vite": "^8.0.12"
    }
}
